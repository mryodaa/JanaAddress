# выданные организаторами данные в репозиторий не попадают
data/
!data/.gitkeep
# окружение
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
var/
out*.json
*.tar
# сборка справочника: сырьё большое и скачивается заново
scripts/build_reference/cache/
# фронт
frontend/node_modules/
frontend/.vite/
*.egg-info/
*.tsbuildinfo
# локальные настройки Claude Code и окружения
.claude/settings.local.json
.env
*.log

# обучение теггера: окружение, чекпойнты и логи (артефакт для образа лежит в models/)
.venv-train/
training/runs/
training_*.log

# снапшот справочника для генератора синтетики (config.SYNTH_DB), не в git и не в образе
reference/reference.synth_v1.sqlite
# промежуточные справочники (в git и образе только reference/reference.sqlite)
reference/*.sqlite
!reference/reference.sqlite
