{
 "openapi": "3.1.0",
 "info": {
  "title": "Jana Address API",
  "description": "Разбор адресов Казахстана на поля с восстановлением по собственному справочнику.",
  "version": "0.1.0"
 },
 "paths": {
  "/api/v1/auth": {
   "get": {
    "tags": [
     "service"
    ],
    "summary": "Нужен ли ключ и принят ли он (для UI)",
    "operationId": "auth_status_api_v1_auth_get",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AuthOut"
        }
       }
      }
     }
    }
   },
   "post": {
    "tags": [
     "service"
    ],
    "summary": "Вход в UI по ключу: ставит cookie (HttpOnly, SameSite=Strict)",
    "operationId": "auth_login_api_v1_auth_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/AuthIn"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AuthOut"
        }
       }
      }
     },
     "401": {
      "description": "неверный ключ"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "delete": {
    "tags": [
     "service"
    ],
    "summary": "Выйти из UI: удалить cookie",
    "operationId": "auth_logout_api_v1_auth_delete",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/AuthOut"
        }
       }
      }
     }
    }
   }
  },
  "/api/v1/parse/batch": {
   "post": {
    "tags": [
     "parse"
    ],
    "summary": "Разбор пакета в формате sample_input.json -> sample_output.json",
    "operationId": "parse_batch_api_v1_parse_batch_post",
    "parameters": [
     {
      "name": "explain",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "description": "добавить источники полей и trace",
       "default": false,
       "title": "Explain"
      },
      "description": "добавить источники полей и trace"
     }
    ],
    "responses": {
     "200": {
      "description": "Ответ в той же форме контейнера, что вход; для JSONL application/x-ndjson",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/OutputRecord"
         },
         "title": "Response Parse Batch Api V1 Parse Batch Post"
        }
       },
       "application/x-ndjson": {
        "schema": {
         "type": "string"
        }
       }
      }
     },
     "413": {
      "description": "тело больше лимита JANA_MAX_UPLOAD_MB"
     },
     "422": {
      "description": "не JSON/JSONL или нет записей"
     }
    },
    "requestBody": {
     "required": true,
     "description": "Тело в формате sample_input.json (application/json) или файл (multipart/form-data, поле file). Принимается и объект со списком записей ({\"records\": [...]}), одиночная запись, JSONL: ответ возвращается в той же форме контейнера",
     "content": {
      "application/json": {
       "schema": {
        "type": "array",
        "items": {
         "$ref": "#/components/schemas/InputRecord"
        }
       },
       "example": [
        {
         "id": "rec_00417",
         "raw_address": "город Алматы/Алматы қаласы, Мкр Аксай 3а, 59, кв 70"
        }
       ]
      },
      "multipart/form-data": {
       "schema": {
        "type": "object",
        "properties": {
         "file": {
          "type": "string",
          "format": "binary"
         }
        },
        "required": [
         "file"
        ]
       }
      }
     }
    }
   }
  },
  "/api/v1/parse": {
   "post": {
    "tags": [
     "parse"
    ],
    "summary": "Разбор одной строки",
