        {
         "type": "null"
        }
       ],
       "description": "столбец гистограммы сводки: уверенность [b/10, (b+1)/10), у 9 включая 1.0",
       "title": "Bucket"
      },
      "description": "столбец гистограммы сводки: уверенность [b/10, (b+1)/10), у 9 включая 1.0"
     },
     {
      "name": "skipped",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "title": "Skipped"
      }
     },
     {
      "name": "no_address",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ],
       "description": "true: только записи без raw_address, false: без них; пусто: все",
       "title": "No Address"
      },
      "description": "true: только записи без raw_address, false: без них; пусто: все"
     },
     {
      "name": "threshold",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "number",
         "maximum": 1.0,
         "minimum": 0.0
        },
        {
         "type": "null"
        }
       ],
       "description": "порог неуверенности вместо сохранённого в сессии (настройка UI)",
       "title": "Threshold"
      },
      "description": "порог неуверенности вместо сохранённого в сессии (настройка UI)"
     },
     {
      "name": "offset",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 0,
       "default": 0,
       "title": "Offset"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 1000,
       "minimum": 1,
       "default": 500,
       "title": "Limit"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/RecordList"
        }
       }
      }
     },
